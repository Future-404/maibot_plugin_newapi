{
  "manifest_version": 2,
  "id": "future-404.maibot-plugin-newapi",
  "version": "2.6.0",
  "name": "NewAPI 插件套件",
  "description": "集成了核心用户管理与娱乐功能的 New API 插件套件，专为 MaiBot 环境优化移植。",
  "author": {
    "name": "Future-404",
    "url": "https://github.com/Future-404"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Future-404/maibot_plugin_newapi"
  },
  "host_application": {
    "min_version": "1.1.3",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24.0"
    }
  ],
  "plugin_type": "management",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "wallet"
    }
  },
  "capabilities": ["send.text"],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
